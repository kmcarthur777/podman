# Copied to ~/homelab/gluetun/vpn.env (chmod 600) by deploy.sh. Edit THAT file,
# never commit real keys.
#
# ProtonVPN via WireGuard. Needs a paid plan (Plus or higher) for P2P servers
# and port forwarding.
#
# Get your key: account.protonvpn.com -> Downloads -> WireGuard configuration
#   - Platform: Router (or GNU/Linux)
#   - NAT-PMP (Port Forwarding): ON      <- required
#   - VPN Accelerator: ON, Moderate NAT: OFF, NetShield: off (gluetun does DNS)
#   - Pick any P2P server (the key works on all of them), click Create
#   - Copy ONLY the "PrivateKey = ..." value from the config into the line below.

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=REPLACE_ME

# Only use P2P servers that support port forwarding.
VPN_PORT_FORWARDING=on
PORT_FORWARD_ONLY=on

# Optional, but pick the country nearest to you for speed (comma-separate several).
# Leave commented to let gluetun pick any P2P server worldwide.
# SERVER_COUNTRIES=United States
# SERVER_CITIES=Chicago

# Proton gives you a new forwarded port every time the VPN reconnects. This
# pushes it into qBittorrent automatically and pins qBittorrent to the VPN
# interface. Requires qBittorrent: Options -> Web UI -> "Bypass authentication
# for clients on localhost" = ON (only containers inside the vpn pod are "localhost").
VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'wget -O- --retry-connrefused --post-data "json={\"listen_port\":{{PORT}},\"current_network_interface\":\"{{VPN_INTERFACE}}\",\"random_port\":false,\"upnp\":false}" http://127.0.0.1:8080/api/v2/app/setPreferences 2>&1'
