# Copied to ~/homelab/gluetun/vpn.env (chmod 600) by deploy.sh. Edit THAT file,
# never commit real keys. Full provider list + options:
#   https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
#
# Pick ONE block and fill it in. WireGuard is faster than OpenVPN.

# --- ProtonVPN (WireGuard, supports port forwarding = faster torrents) ---
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=REPLACE_ME
SERVER_COUNTRIES=Netherlands
VPN_PORT_FORWARDING=on
PORT_FORWARD_ONLY=on

# --- Mullvad (WireGuard, no port forwarding) ---
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=REPLACE_ME
# WIREGUARD_ADDRESSES=10.x.x.x/32
# SERVER_COUNTRIES=Sweden

# --- Private Internet Access (OpenVPN, supports port forwarding) ---
# VPN_SERVICE_PROVIDER=private internet access
# OPENVPN_USER=REPLACE_ME
# OPENVPN_PASSWORD=REPLACE_ME
# SERVER_REGIONS=Netherlands
# VPN_PORT_FORWARDING=on
